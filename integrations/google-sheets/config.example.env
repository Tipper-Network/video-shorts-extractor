# Copy these into workspace `.env` (gitignored). Do not commit real values.

# Spreadsheet ID from the URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEETS_ID>/edit
GOOGLE_SHEETS_ID=

# Path to OAuth client JSON or service-account JSON (relative to workspace root)
GOOGLE_SHEETS_CREDENTIALS=integrations/google-sheets/credentials/oauth-client.json

# Optional if you store client id separately (NOT the spreadsheet id)
# GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
