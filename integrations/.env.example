# =============================================================================
# Content pipeline — publish integrations
# Copy to:  integrations/.env  and/or workspace `.env`  (both gitignored)
# Fill what you have; leave the rest blank until that platform is ready.
# =============================================================================

# -----------------------------------------------------------------------------
# Google (Sheets + YouTube share one Cloud project / OAuth client)
# -----------------------------------------------------------------------------

# OAuth Desktop client — from Google Cloud → Credentials
# Prefer also saving the downloaded JSON as:
#   step-5-google-sheets/credentials/oauth-client.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Path to the downloaded OAuth client JSON (includes id + secret)
GOOGLE_OAUTH_CLIENT_JSON=step-5-google-sheets/credentials/oauth-client.json

# Spreadsheet ID from URL: …/d/<THIS>/edit
GOOGLE_SHEETS_ID=

# Optional: tab name or gid for the catalog tab
GOOGLE_SHEETS_TAB=Sheet1
# GOOGLE_SHEETS_GID=1525533650

# Written automatically after first browser login — do not invent
# GOOGLE_OAUTH_TOKEN_JSON=step-5-google-sheets/credentials/token.json

# YouTube channel to upload Shorts into (NOT an email)
# Find it: YouTube Studio → Settings → Channel → Channel ID  (starts with UC…)
YOUTUBE_CHANNEL_ID=

# Optional human label for which brand this Google login posts as
# YOUTUBE_CHANNEL_LABEL=founder
# Later, if Tipper / GAF / founder use different channels:
# YOUTUBE_CHANNEL_ID_TIPPER=UC…
# YOUTUBE_CHANNEL_ID_GAF=UC…
# YOUTUBE_CHANNEL_ID_FOUNDER=UC…

# -----------------------------------------------------------------------------
# Instagram Reels (Meta Graph API) — Business app only (not Consumer)
# Aliases: APP_ID / ACCESS_TOKEN / IG_BUSINESS_ID / PAGE_ID also accepted.
# Docs: integrations/platforms/instagram/docs/setup.md
# -----------------------------------------------------------------------------

META_APP_ID=
# APP_ID=
META_APP_SECRET=
# APP_SECRET=

# Long-lived token with instagram_content_publish (~60 days; refresh with app secret)
META_ACCESS_TOKEN=
# ACCESS_TOKEN=

# From Graph Explorer: GET /me/accounts → Page id
FACEBOOK_PAGE_ID=
# PAGE_ID=

# From Graph Explorer: GET /{PAGE_ID}?fields=instagram_business_account → id
IG_BUSINESS_ID=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=

# false = Reels tab only (not main profile grid). Browser upload cannot do this.
IG_SHARE_TO_FEED=false

# Reel collaborators (usernames, comma-separated, no @)
# Sent as JSON array: ["tipper.network","thehardport"]
IG_COLLABORATORS=tipper.network,thehardport

# Public HTTPS base (optional fallback if NOT using AWS upload+presign)
# Example: https://cdn.example.com/reels
MEDIA_PUBLIC_BASE_URL=
# Optional path prefix under that base / inside the bucket
# MEDIA_PUBLIC_PREFIX=socials

# --- S3 media host (upload → stable path-style public URL) ---
# Keys: socials/{path under step-4}/…  e.g. socials/gaf/qualifications-2/01-attract/01_sh04_….mp4
# Bucket policy should Allow s3:GetObject on arn:aws:s3:::BUCKET/socials/*
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
S3_URI=s3://socials.bucket/socials/
# S3_BUCKET=socials.bucket
# S3_ARN=arn:aws:s3:::socials.bucket
# S3_URL=https://s3.eu-north-1.amazonaws.com/socials.bucket/socials/
# Fallback only if objects are not publicly readable:
# S3_USE_PRESIGN=false
# S3_PRESIGN_EXPIRES=21600

# Optional per-entity later
# IG_BUSINESS_ID_TIPPER=
# IG_BUSINESS_ID_GAF=
# IG_BUSINESS_ID_FOUNDER=

# -----------------------------------------------------------------------------
# TikTok (Content Posting API) — leave blank until app + audit approved
# -----------------------------------------------------------------------------

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# After OAuth — refresh token stored locally (gitignored)
# TIKTOK_REFRESH_TOKEN=
# TIKTOK_ACCESS_TOKEN=

# Open API app identity (from TikTok developer portal)
TIKTOK_APP_ID=

# Optional per-entity open_id after each account connects
# TIKTOK_OPEN_ID_TIPPER=
# TIKTOK_OPEN_ID_GAF=
# TIKTOK_OPEN_ID_FOUNDER=

# -----------------------------------------------------------------------------
# Behaviour flags (scripts will read these later)
# -----------------------------------------------------------------------------

# Never auto-post without this: only rows with status=approved are eligible
PUBLISH_REQUIRE_APPROVED=true

# dry_run=true → log what would upload, do not hit APIs
PUBLISH_DRY_RUN=true
