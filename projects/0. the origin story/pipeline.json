{
  "project_id": "origin-story",
  "playbook_id": "flywheel-shorts",
  "description": "The Origin Story — speech long-form → flywheel shorts queue",
  "overrides": {
    "modules": {
      "transcribe": { "enabled": true, "vosk_words": false },
      "detect_topics": { "enabled": true },
      "render": { "enabled": true, "trim_on_render": true, "render_chapters": true },
      "compose_shorts": { "enabled": false }
    },
    "chapters": {
      "enabled": true,
      "cut_mode": "contiguous",
      "default_trim": "light"
    },
    "shorts": {
      "cut_mode": "supercut",
      "default_trim": "moderate",
      "supercut_allowed": true
    }
  }
}
