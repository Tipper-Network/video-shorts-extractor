{
  "playbook_id": "podcast-chapter",
  "name": "Podcast single chapter",
  "description": "One 11–15 min contiguous mid-form chunk from speech. Optional 1–2 vertical shorts.",
  "module_order": [
    "transcribe",
    "detect_topics",
    "plan_manifest",
    "render"
  ],
  "skills": [
    "skills/detect_topics",
    "skills/chunks",
    "skills/vertical_shorts"
  ],
  "modules": {
    "concat": { "enabled": false },
    "transcribe": { "enabled": true, "vosk_words": false },
    "detect_topics": { "enabled": true, "method": "heuristic" },
    "plan_manifest": { "enabled": true, "planner": "cursor-agent" },
    "compose_shorts": { "enabled": false },
    "render": { "enabled": true, "trim_on_render": true },
    "trim_silence": { "enabled": false },
    "polish": { "enabled": false }
  },
  "chapters": {
    "cut_mode": "contiguous",
    "min_sec": 660,
    "max_sec": 900,
    "default_trim": "light"
  },
  "shorts": {
    "cut_mode": "contiguous",
    "default_trim": "moderate",
    "versions": ["hook-first", "story-first", "contiguous"]
  },
  "deliverables": {
    "shorts": {
      "skill": "skills/vertical_shorts",
      "versions": ["hook-first", "story-first", "contiguous"]
    },
    "chunks": {
      "skill": "skills/chunks"
    }
  },
  "flywheel": {
    "enabled": false,
    "tag_shorts": false
  }
}
