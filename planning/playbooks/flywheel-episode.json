{
  "playbook_id": "flywheel-episode",
  "strategy": "flywheel-episode",
  "name": "Flywheel episode",
  "description": "Strategy B: A 10–30 min YouTube chapter IS the service delivery. Flywheel shorts tease, support, and close around it. Publish: pre-shorts → chapter → post-shorts.",
  "primary_output": "chapters_and_shorts",
  "conclusion": "Viewer follows shorts into the full chapter for payoff; post-shorts cement trust and loop to next episode.",
  "module_order": [
    "transcribe",
    "detect_topics",
    "plan_manifest",
    "render",
    "polish"
  ],
  "technical_modules": {
    "transcribe": { "enabled": true, "vosk_words": false },
    "detect_topics": { "enabled": true, "method": "heuristic", "pause_threshold_sec": 2.5 },
    "compose_shorts": { "enabled": false },
    "render": { "enabled": true, "trim_on_render": true, "render_chapters": true },
    "trim_silence": { "enabled": false },
    "polish": { "enabled": true, "sfx": true, "zoom": false }
  },
  "narrative_modules": {
    "plan_chapter": {
      "enabled": true,
      "focus": "chapter_first",
      "skills": ["skills/detect_topics", "skills/youtube_chunks"],
      "notes": "One self-contained 10–30 min contiguous chapter per topic. Service = full delivery here."
    },
    "plan_shorts_around_chapter": {
      "enabled": true,
      "skills": [
        "skills/youtube_shorts",
        "skills/tiktok_shorts",
        "skills/instagram_reels",
        "skills/flywheel_series"
      ],
      "notes": "Shorts tease parent chapter. parent_chapter required. publish_order wraps chapter."
    },
    "plan_flywheel_sequence": { "enabled": false }
  },
  "modules": {
    "concat": { "enabled": false },
    "transcribe": { "enabled": true, "vosk_words": false },
    "detect_topics": { "enabled": true, "method": "heuristic", "pause_threshold_sec": 2.5 },
    "plan_manifest": { "enabled": true, "planner": "cursor-agent", "focus": "chapter_first_then_shorts" },
    "compose_shorts": { "enabled": false },
    "render": { "enabled": true, "trim_on_render": true },
    "trim_silence": { "enabled": false },
    "polish": { "enabled": true, "sfx": true, "zoom": false }
  },
  "skills": [
    "skills/detect_topics",
    "skills/youtube_chunks",
    "skills/youtube_shorts",
    "skills/tiktok_shorts",
    "skills/instagram_reels",
    "skills/flywheel_series"
  ],
  "chapters": {
    "enabled": true,
    "cut_mode": "contiguous",
    "min_sec": 600,
    "max_sec": 1800,
    "default_trim": "light"
  },
  "shorts": {
    "cut_mode": "contiguous",
    "default_trim": "moderate",
    "require_parent_chapter": true
  },
  "flywheel": {
    "enabled": true,
    "tag_shorts": true,
    "sequence_is_product": false,
    "chapter_is_service_delivery": true
  },
  "acts": [
    {
      "act_id": "hook",
      "stages": ["attract", "engage"],
      "output": "shorts",
      "default_trim": "aggressive",
      "planning": "Pre-chapter shorts. Tease problem/question. publish_order before chapter."
    },
    {
      "act_id": "prove",
      "stages": ["trust"],
      "output": "shorts",
      "default_trim": "moderate",
      "planning": "Optional trust short before chapter drop."
    },
    {
      "act_id": "deliver",
      "stages": ["service"],
      "output": "chapters",
      "default_trim": "light",
      "planning": "THE chapter — 10–30 min full value. Center of publish sequence."
    },
    {
      "act_id": "close",
      "stages": ["referral", "loop"],
      "output": "shorts",
      "default_trim": "moderate",
      "planning": "Post-chapter shorts. Proof + CTA back to chapter + tease next episode."
    }
  ],
  "publish_pattern": ["short", "short", "chapter", "short", "short"]
}
