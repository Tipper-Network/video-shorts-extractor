{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "content-pipeline/manifest",
  "title": "Stream Processing Manifest",
  "description": "Contract between plan and render stages. Source of truth for all clips from one input video.",
  "type": "object",
  "required": ["version", "source", "stem"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "source": { "type": "string" },
    "stem": { "type": "string" },
    "series_id": { "type": "string" },
    "episode": { "type": "integer", "minimum": 1 },
    "content_type": { "type": "string" },
    "planned_at": { "type": "string", "format": "date-time" },
    "planner_model": { "type": "string" },
    "render": {
      "type": "object",
      "properties": {
        "default_trim": { "enum": ["off", "light", "moderate", "aggressive"] },
        "trim_on_render": { "type": "boolean" }
      }
    },
    "chapters": {
      "type": "array",
      "items": { "$ref": "#/definitions/chapter" },
      "default": []
    },
    "shorts": {
      "type": "array",
      "items": { "$ref": "#/definitions/short" },
      "default": []
    },
    "deferred_chapters": {
      "type": "array",
      "items": { "type": "object" },
      "default": []
    },
    "deliverables": {
      "type": "object",
      "properties": {
        "shorts": {
          "type": "object",
          "properties": {
            "skill": { "type": "string" },
            "count": { "type": "integer" },
            "versions": {
              "type": "array",
              "items": { "enum": ["hook-first", "story-first", "contiguous"] }
            }
          }
        },
        "chunks": {
          "type": "object",
          "properties": {
            "skill": { "type": "string" },
            "count": { "type": "integer" },
            "duration_min_sec": { "type": "integer" },
            "duration_max_sec": { "type": "integer" },
            "aspect": { "enum": ["16:9"] }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "status": { "enum": ["draft", "approved", "rejected"] },
        "reviewed_by": { "type": "string" },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      }
    }
  },
  "definitions": {
    "extract_beat": {
      "type": "object",
      "required": ["start", "end", "text"],
      "properties": {
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "segment": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 },
        "label": { "type": "string" },
        "clip_index": { "type": "integer" }
      }
    },
    "chapter": {
      "type": "object",
      "required": ["id", "title", "theme", "aspect", "target"],
      "properties": {
        "id": { "type": "string", "pattern": "^ch[0-9]{2,}$" },
        "cut_mode": {
          "enum": ["contiguous", "supercut"],
          "default": "contiguous",
          "description": "contiguous=single slice; supercut=segments[] montage"
        },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 },
        "segments": {
          "type": "array",
          "items": { "$ref": "#/definitions/segment" },
          "description": "Required when cut_mode=supercut"
        },
        "title": { "type": "string", "minLength": 1 },
        "theme": { "type": "string" },
        "hook": { "type": "string" },
        "aspect": { "enum": ["16:9"], "default": "16:9" },
        "target": { "type": "string", "default": "youtube" },
        "trim": { "enum": ["off", "light", "moderate", "aggressive"] },
        "min_len": { "type": "integer", "default": 600 },
        "max_len": { "type": "integer", "default": 1800 },
        "rendered": { "type": "boolean", "default": false },
        "output_file": { "type": "string" }
      }
    },
    "short": {
      "type": "object",
      "required": ["id", "title", "aspect", "target"],
      "properties": {
        "id": { "type": "string", "pattern": "^sh[0-9]{2,}$" },
        "cut_mode": { "enum": ["contiguous", "supercut"], "default": "contiguous" },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 },
        "segments": {
          "type": "array",
          "items": { "$ref": "#/definitions/segment" }
        },
        "title": { "type": "string", "minLength": 1 },
        "hook_type": { "type": "string" },
        "extract_mode": { "enum": ["splice", "contiguous"] },
        "theme_block": {
          "type": "object",
          "properties": {
            "start": { "type": "number", "minimum": 0 },
            "end": { "type": "number", "minimum": 0 }
          }
        },
        "hook": { "$ref": "#/definitions/extract_beat" },
        "setup": { "$ref": "#/definitions/extract_beat" },
        "resolution": { "$ref": "#/definitions/extract_beat" },
        "coherence": {
          "type": "object",
          "properties": {
            "spoken_as": { "type": "string" },
            "complete": { "type": "boolean" }
          }
        },
        "content_type": { "type": "string" },
        "flywheel_stage": {
          "enum": ["attract", "engage", "trust", "service", "referral", "loop", "n/a"]
        },
        "parent_chapter": { "type": "string" },
        "cta": { "type": "string" },
        "aspect": { "enum": ["9:16"], "default": "9:16" },
        "target": { "type": "string" },
        "version_id": { "enum": ["hook-first", "story-first", "contiguous"] },
        "versions": { "type": "array", "items": { "type": "object" } },
        "trim": { "enum": ["off", "light", "moderate", "aggressive"] },
        "min_len": { "type": "integer" },
        "max_len": { "type": "integer" },
        "publish_order": { "type": "integer" },
        "overflow_ok": { "type": "boolean", "default": false },
        "rendered": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "object", "additionalProperties": { "type": "boolean" } }
          ]
        },
        "output_file": { "type": "string" },
        "output_files": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
